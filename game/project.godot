config_version=5

[application]
config/name="Dixon"
run/main_scene="res://world/world.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]
WorldState="*res://autoload/world_state.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
textures/vram_compression/import_etc2_astc=false
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/quality=1
environment/ssil/half_size=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
environment/volumetric_fog/use_filter=true
environment/glow/upscale_mode=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

[shader_globals]
snow_cover={"type":"float","value":0.0}
wetness={"type":"float","value":0.0}
season_foliage={"type":"float","value":0.0}
wind_strength={"type":"float","value":0.2}
night_factor={"type":"float","value":0.0}
